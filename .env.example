# Server configuration (Express/Node runtime; all have safe defaults)
PORT=3000
NODE_ENV=development

# Media processing & security limits (non-secret, safe defaults)
TEMP_DIR=/tmp/clipfetch_jobs
MAX_FILE_SIZE_MB=500
MAX_DURATION_SEC=3600
MAX_CONCURRENT_JOBS=4
JOB_TIMEOUT_SEC=600
AUTO_CLEANUP_MINUTES=15

# Optional explicit binary paths (auto-detected by default; leave blank unless overriding)
YTDLP_BIN=
FFMPEG_BIN=
FFPROBE_BIN=
NODE_BIN=

# Optional sensitive/manual override: path to a Netscape cookies.txt file on the server
# Only needed on cloud/datacenter IPs for YouTube/auth-gated public posts (never commit real cookies)
YTDLP_COOKIES_FILE=

# Flask backend settings (only used when running Python/Flask backend independently)
FLASK_HOST=0.0.0.0
FLASK_PORT=5000
FLASK_DEBUG=false
CORS_ORIGINS=*
